{
  "name": "@rol1n/pi-kit",
  "version": "0.1.1",
  "description": "A selectable collection of Pi extensions and prompt templates.",
  "extensions": {
    "ask-u-questions": { "bundle": true },
    "continue-signal": { "bundle": true },
    "custom-providers": {
      "bundle": true,
      "exports": {
        ".": "./index.ts",
        "./asr": "./asr/index.ts",
        "./image": "./image/index.ts",
        "./chat": "./chat/index.ts"
      }
    },
    "image-generate": { "bundle": true, "deps": ["custom-providers"] },
    "memory-log": { "bundle": true },
    "model-vision": { "bundle": false },
    "multi-harness": { "bundle": true, "deps": ["subagent"] },
    "oai-subquota": { "bundle": true },
    "prompt-snipaste": { "bundle": true },
    "screenshot": { "bundle": false },
    "srp-theme": { "bundle": true },
    "subagent": {
      "bundle": true,
      "exports": {
        ".": "./index.ts",
        "./mux": "./mux.ts"
      }
    },
    "tui-asr": { "bundle": true, "deps": ["custom-providers"] },
    "web-reach": { "bundle": true },
    "windows-wheel-fix": { "bundle": true }
  }
}
