{
  "name": "@rol1n/pi-kit",
  "version": "0.1.3",
  "description": "A selectable collection of Pi extensions, prompt templates, and skills.",
  "author": "RoL1n_SrP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RolinShmily/pi-kit.git"
  },
  "homepage": "https://github.com/RolinShmily/pi-kit#readme",
  "bugs": {
    "url": "https://github.com/RolinShmily/pi-kit/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "node scripts/check-package.mjs",
    "test": "node --experimental-strip-types --test memory-log/hooks/*.test.ts memory-log/ledger/*.test.ts prompt-snipaste/*.test.ts",
    "prepack": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README_zh.md",
    "scripts/check-package.mjs",
    "prompts",
    "skills",
    "ask-u-questions",
    "continue-signal",
    "custom-providers",
    "image-generate",
    "memory-log",
    "model-vision",
    "multi-harness",
    "subagent",
    "oai-subquota",
    "prompt-snipaste",
    "screenshot",
    "srp-theme",
    "tui-asr",
    "web-reach",
    "windows-wheel-fix",
    "!**/test/**",
    "!**/tests/**",
    "!**/*.{test,spec}.{ts,js,mjs,cjs}",
    "!**/.env",
    "!**/.env.*"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./ask-u-questions/index.ts",
      "./continue-signal/index.ts",
      "./custom-providers/index.ts",
      "./image-generate/index.ts",
      "./memory-log/index.ts",
      "./model-vision/index.ts",
      "./multi-harness/index.ts",
      "./oai-subquota/index.ts",
      "./prompt-snipaste/index.ts",
      "./screenshot/index.ts",
      "./srp-theme/index.ts",
      "./subagent/index.ts",
      "./tui-asr/index.ts",
      "./web-reach/index.ts",
      "./windows-wheel-fix/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": []
  }
}
