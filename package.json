{
  "name": "pi-kit",
  "version": "0.1.0",
  "description": "A selectable collection of Pi extensions and prompt templates.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/RolinShmily/pi-kit.git"
  },
  "homepage": "https://github.com/RolinShmily/pi-kit#readme",
  "bugs": {
    "url": "https://github.com/RolinShmily/pi-kit/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "manifest": "node scripts/package.mjs sync",
    "check": "node scripts/package.mjs check",
    "prepare:extension": "node scripts/package.mjs extension",
    "prepare:fork": "node scripts/package.mjs fork",
    "prepack": "node scripts/package.mjs check"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "THIRD_PARTY.md",
    "prompts",
    "extensions/ask-u-questions.ts",
    "extensions/continue-signal.ts",
    "extensions/custom-providers",
    "extensions/image-generate.ts",
    "extensions/memory-log",
    "extensions/multi-harness",
    "extensions/subagent/mux.ts",
    "extensions/prompt-snipaste.ts",
    "extensions/srp-theme.ts",
    "extensions/subagent",
    "extensions/tui-asr.ts",
    "!**/test/**",
    "!**/tests/**",
    "!**/*.{test,spec}.{ts,js,mjs,cjs}",
    "!**/.env",
    "!**/.env.*"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/ask-u-questions.ts",
      "./extensions/continue-signal.ts",
      "./extensions/custom-providers/index.ts",
      "./extensions/image-generate.ts",
      "./extensions/memory-log/index.ts",
      "./extensions/multi-harness/index.ts",
      "./extensions/prompt-snipaste.ts",
      "./extensions/srp-theme.ts",
      "./extensions/subagent/index.ts",
      "./extensions/tui-asr.ts"
    ],
    "skills": [],
    "prompts": [
      "./prompts"
    ],
    "themes": []
  }
}
