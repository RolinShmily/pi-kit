{
  "name": "@rol1n/pi-kit",
  "version": "0.1.1",
  "description": "A selectable collection of Pi extensions and prompt templates.",
  "author": "RoL1n_SrP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RolinShmily/pi-kit.git"
  },
  "homepage": "https://github.com/RolinShmily/pi-kit#readme",
  "bugs": {
    "url": "https://github.com/RolinShmily/pi-kit/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "manifest": "node scripts/package.mjs sync",
    "check": "node scripts/package.mjs check",
    "prepare:extension": "node scripts/package.mjs extension",
    "publish:ci": "node scripts/package.mjs publish",
    "prepack": "node scripts/package.mjs check"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README_zh.md",
    "ask-u-questions/README.md",
    "continue-signal/README.md",
    "custom-providers/README.md",
    "image-generate/README.md",
    "memory-log/README.md",
    "model-vision/README.md",
    "multi-harness/README.md",
    "oai-subquota/README.md",
    "prompt-snipaste/README.md",
    "screenshot/README.md",
    "srp-theme/README.md",
    "subagent/README.md",
    "tui-asr/README.md",
    "web-reach/README.md",
    "windows-wheel-fix/README.md",
    "ask-u-questions",
    "continue-signal",
    "custom-providers",
    "image-generate",
    "memory-log",
    "multi-harness",
    "subagent",
    "oai-subquota",
    "prompt-snipaste",
    "srp-theme",
    "tui-asr",
    "windows-wheel-fix",
    "!**/test/**",
    "!**/tests/**",
    "!**/*.{test,spec}.{ts,js,mjs,cjs}",
    "!**/.env",
    "!**/.env.*"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./ask-u-questions/index.ts",
      "./continue-signal/index.ts",
      "./custom-providers/index.ts",
      "./image-generate/index.ts",
      "./memory-log/index.ts",
      "./multi-harness/index.ts",
      "./oai-subquota/index.ts",
      "./prompt-snipaste/index.ts",
      "./srp-theme/index.ts",
      "./subagent/index.ts",
      "./tui-asr/index.ts",
      "./windows-wheel-fix/index.ts"
    ],
    "skills": [],
    "prompts": [
      "./prompt-snipaste/prompts"
    ],
    "themes": []
  }
}
